rules_version = '2';

// Reglas de Storage para CAFIVER — Gestión de Equipos.
//
// Las fotos se muestran con enlaces directos (...?alt=media) en la consola,
// la app del técnico y el comprobante público, así que abrir UN archivo por
// su ruta sigue siendo público.
//
// Listar carpetas y subir o borrar SI exige ser usuario dado de alta. Antes
// bastaba `request.auth != null`, que no quiere decir nada: el registro de
// Firebase esta abierto y el apiKey es publico, asi que cualquiera en
// internet podia crearse una cuenta desde la consola del navegador y:
//   storage.ref('ordenes').listAll()   -> enumerar todas las carpetas
//   ...                   .delete()    -> borrar firmas y fotos de servicio
//   ...                   .put(...)    -> reemplazar la evidencia, o subir
//                                         lo que quisiera al bucket
// Ahora se exige lo mismo que en Firestore: documento en `usuarios` y que no
// este desactivado.
service firebase.storage {
  match /b/{bucket}/o {

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function autorizado() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && perfil().activo != false;
    }

    match /{allPaths=**} {
      allow get:          if true;
      allow list, write:  if autorizado();
    }
  }
}
