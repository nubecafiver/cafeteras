rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════
    //  ETAPA 1 — cerrar escalada de privilegios y escritura indebida
    //
    //  El apiKey viaja en el navegador (es normal en Firebase), asi que
    //  cualquiera puede crearse una cuenta de Auth. Por eso NO basta con
    //  pedir sesion: se exige ademas tener documento en `usuarios` y estar
    //  activo. Una cuenta auto-registrada entra a Auth pero no lee nada.
    //
    //  Las colecciones que alimenta el servidor (equipos, config, catalogos)
    //  quedan SOLO LECTURA: ninguna app del navegador las escribe, eso lo
    //  hace importar.js con el SDK Admin, que se salta estas reglas.
    // ══════════════════════════════════════════════════════════════════

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Usuario de la casa: con sesion, con perfil y no desactivado.
    function autorizado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().activo != false;
    }

    function rol() {
      return autorizado() ? perfil().rol : '';
    }

    // OJO: esAdmin() incluia 'jefe' y no mira centros, y era la unica
    // condicion para 'delete' en ocho colecciones: un coordinador de EUCA
    // podia borrar ordenes de cualquier centro del pais. Ahora un jefe
    // administra DENTRO de su alcance (ver puedeEnCentro), y borrar queda
    // en direccion.
    function esAdmin() {
      return rol() == 'admin' || rol() == 'jefe' || rol() == 'director' || rol() == 'gerente';
    }

    // Administra, pero solo donde le toca. Es lo que sustituye a esAdmin()
    // en todo lo que lleva centro.
    function puedeEnCentro(c) {
      return esAdmin() && centroPermitido(c);
    }

    // Direccion nacional: puede asignar cualquier rol.
    function esDireccion() {
      return rol() == 'admin' || rol() == 'director' || rol() == 'gerente';
    }

    // ── Alcance por centro ──────────────────────────────────────────
    // El candado de centro no puede vivir solo en el navegador: cualquiera
    // con la consola puede escribir directo. Un tecnico de EUCA no debe
    // poder levantar una orden sobre un equipo de EUBA.
    function alcanceNacional() {
      return rol() == 'admin' || rol() == 'director' || rol() == 'gerente';
    }
    function misCentros() {
      return autorizado() && perfil().centros is list ? perfil().centros : [];
    }
    function centroPermitido(c) {
      return alcanceNacional() || c in misCentros();
    }

    // ── USUARIOS ──────────────────────────────────────────────────────
    // Cada quien lee su propio perfil (la app lo necesita al entrar).
    // Solo un administrador puede crear, editar o desactivar usuarios:
    // esto cierra la escalada de privilegios.
    // Un coordinador (jefe) administra TECNICOS, nada mas.
    //
    // Antes podia editar cualquier documento cuyo rol estuviera en
    // ['tecnico','jefe'] — y el suyo propio tiene rol 'jefe'. Es decir que
    // desde la consola del navegador podia hacer
    //   usuarios/<su uid>.set({centros:[...los 30]}, {merge:true})
    // y pasar a ver y editar todo el pais. Tambien podia desactivar a otro
    // coordinador. Ahora:
    //   - no puede tocar su propio documento (uid != request.auth.uid)
    //   - solo alcanza documentos de rol 'tecnico', ni jefes ni direccion
    //   - no puede mover centros: eso lo hace la direccion
    // Crear un tecnico con sus centros si puede; reasignarlo de centro no.
    match /usuarios/{uid} {
      allow get:    if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow list:   if esAdmin();
      allow create: if esDireccion()
                    || (rol() == 'jefe'
                        && uid != request.auth.uid
                        && request.resource.data.rol == 'tecnico');
      allow update: if esDireccion()
                    || (rol() == 'jefe'
                        && uid != request.auth.uid
                        && resource.data.rol == 'tecnico'
                        && request.resource.data.rol == 'tecnico'
                        && request.resource.data.centros == resource.data.centros);
      allow delete: if esDireccion();
    }

    // ── ORDENES ───────────────────────────────────────────────────────
    // Leer UNA por su id sigue siendo publico: es el comprobante que el
    // cliente abre desde WhatsApp y no tiene cuenta. El id lo genera
    // Firestore al azar, asi que no se puede adivinar.
    // Listar la coleccion completa si requiere ser de la casa.
    match /ordenes/{id} {
      allow get:    if true;
      allow list:   if autorizado() && centroPermitido(resource.data.centro);
      allow create: if autorizado()
                    && centroPermitido(request.resource.data.centro)
                    && (esAdmin() || request.resource.data.tecnicoUid == request.auth.uid);
      allow update: if autorizado()
                    && centroPermitido(resource.data.centro)
                    && centroPermitido(request.resource.data.centro);
      allow delete: if puedeEnCentro(resource.data.centro);
    }

    // ── TRABAJO DIARIO ────────────────────────────────────────────────
    match /auditorias/{id} {
      allow get:    if autorizado() && centroPermitido(resource.data.centro);
      allow list:   if autorizado() && centroPermitido(resource.data.centro);
      allow create: if autorizado() && centroPermitido(request.resource.data.centro);
      allow update: if autorizado()
                    && centroPermitido(resource.data.centro)
                    && centroPermitido(request.resource.data.centro);
      allow delete: if puedeEnCentro(resource.data.centro);
    }

    // El id es predecible: uid_YYYY-MM-DD. Antes read y update eran
    // autorizado() a secas, asi que cualquier tecnico podia leer las rutas
    // de los 49 tecnicos del pais — con clientes y notas — y dejar sin ruta
    // a un compañero de otro centro escribiendo su id.
    match /rutas/{id} {
      allow read:   if autorizado()
                    && (resource.data.tecnicoUid == request.auth.uid
                        || centroPermitido(resource.data.centro));
      allow create: if puedeEnCentro(request.resource.data.centro);
      allow update: if autorizado()
                    && (resource.data.tecnicoUid == request.auth.uid
                        || centroPermitido(resource.data.centro));
      allow delete: if puedeEnCentro(resource.data.centro);
    }

    // El ultimo movimiento con estadoNuevo manda para TODOS los que ven el
    // tablero. Antes create era autorizado() a secas: un tecnico podia
    // recorrer la lista de activos y marcar el parque nacional como BAJA,
    // firmando con el nombre de otra persona, y no podia revertirlo porque
    // update y delete son de admin. Ahora el movimiento tiene que ser de su
    // alcance y el correo tiene que ser el suyo.
    match /movimientos/{id} {
      allow read:   if autorizado() && centroPermitido(resource.data.centro);
      allow create: if autorizado()
                    && centroPermitido(request.resource.data.centro)
                    && request.resource.data.usuarioEmail == request.auth.token.email;
      allow update, delete: if esDireccion();
    }

    // ── DATOS DEL SERVIDOR — SOLO LECTURA ─────────────────────────────
    // Los escribe importar.js / cafiver-resumen.js con el SDK Admin.
    // Ninguna pantalla del navegador los modifica.
    // EQUIPOS es la coleccion gorda: 37,900 documentos con cliente, serie,
    // modelo y centro. Con 'read: if autorizado()' cualquier tecnico podia
    // abrir DevTools en su propio celular y recorrer el alfabeto con la
    // misma consulta que ya hace la app — sin filtro de centro — y bajarse
    // el padron nacional completo. Los filtros de pantalla solo ocultan:
    // los datos ya llegaron al navegador.
    //
    // get vs list: el ID del documento ES el activo fijo, asi que leer UNO
    // por su id sigue abierto — es lo que necesita el escaneo del QR para
    // poder decirle al tecnico "este equipo es de otro centro". Lo que se
    // cierra es LISTAR, que es lo que permite la extraccion masiva.
    match /equipos/{id} {
      allow get:   if autorizado();
      allow list:  if autorizado() && centroPermitido(resource.data.centro);
      allow write: if false;
    }
    match /config/{id}        { allow read: if autorizado(); allow write: if false; }
    match /resumenLinea/{id}  { allow read: if autorizado(); allow write: if false; }
    match /centros/{id}       { allow read: if autorizado(); allow write: if false; }
    match /almacenes/{id} {
      allow get:   if autorizado();
      allow list:  if autorizado() && centroPermitido(resource.data.centro);
      allow write: if false;
    }
    match /clientes/{id}      { allow read: if autorizado(); allow write: if false; }
    match /materiales/{id}    { allow read: if autorizado(); allow write: if false; }
    match /specs_equipos/{id} { allow read: if autorizado(); allow write: if false; }

    // Lo consulta la ficha del equipo en el escritorio.
    match /clientesEquipo/{id} {
      allow read:  if autorizado();
      allow write: if esDireccion();   // asignacion cliente-equipo: nacional
    }

    // Ubicacion de referencia de cada cliente, capturada en la primera
    // visita. Cualquier tecnico puede crearla; para corregir una existente
    // hace falta ser administrador, asi un GPS malo no pisa la buena.
    match /ubicaciones/{id} {
      allow read:   if autorizado();
      allow create: if autorizado();
      allow update, delete: if esDireccion();
    }

    // ── DIRECTORIO ────────────────────────────────────────────────────
    // Trae nombre, direccion, correo, telefono y RFC. Antes cualquier
    // tecnico podia bajarse el padron nacional completo. El documento tiene
    // centro, asi que se acota igual que todo lo demas.
    match /directorio/{id} {
      allow get:   if autorizado() && centroPermitido(resource.data.centro);
      allow list:  if autorizado() && centroPermitido(resource.data.centro);
      allow write: if esDireccion();
    }

    // ── TODO LO DEMAS ─────────────────────────────────────────────────
    // Cualquier coleccion que no este arriba queda cerrada. Si manana
    // aparece una nueva, hay que agregarla aqui a proposito: es preferible
    // que falle visible a que quede abierta sin que nadie lo note.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
